---
import '../styles/global.css';
import { ArrowLeft, ChevronDown, Droplets, Sun } from 'lucide-astro';
const site = import.meta.env.PUBLIC_SITE_URL || 'https://gethsemaneil.com';
const canonical = new URL('/', site).toString();
const mapsUrl = 'https://maps.app.goo.gl/int1LT9WUDdZW2u57';
const operatorUrl = 'https://www.custodia.org/en/sanctuaries/gethsemane-basilica-agony/';
const cicUrl = 'https://www.cicts.org/our-services/';
const ratingValue = '4.8';
const reviewCount = '14,670';
const syncDate = '29.10.2026';
const title = 'גת שמנים: הגן, כנסיית כל העמים ושעות ביקור | מדריך עצמאי';
const description = 'מדריך לגת שמנים בירושלים: ההבדל בין גן הזיתים, כנסיית כל העמים והמערה, שעות עונתיות ומחלוקות בין המקורות, הגעה וביקור מכבד. יש לאשר את שעות הגישה לפני היציאה.';
const heroImage = `${canonical}images/olive-illustration.png`;
const faqs = [
  ['האם גת שמנים וכנסיית כל העמים הם אותו אתר?', 'לא. גת שמנים מתייחס בהקשר זה לגן הזיתים ולמקומות קדושים סמוכים. כנסיית כל העמים, המכונה גם בזיליקת היגון, והמערה הם אתרים נפרדים. אין להניח ששעות הביקור או תנאי הכניסה זהים.'],
  ['מהן שעות הפתיחה של גת שמנים ושל הכנסייה?', 'המקורות מפרידים בין המתחם, הכנסייה והמערה ומפרסמים שעות עונתיות שונות. בטבלת הביקור בעמוד מוצגים נתוני הקוסטודיה ומרכז המידע הנוצרי, לרבות ההבדלים ביניהם. יש לאשר את השעות ואת הכניסה למקום המדויק לפני היציאה, במיוחד בחגים ובזמני תפילה.'],
  ['האם הכניסה חינם?', 'לא אותר במקורות שנבדקו מחירון עדכני שמאשר כניסה חופשית לכל אחד מהאתרים והשירותים. יש לברר עם המפעיל אם נדרש תשלום או תיאום למקום ולפעילות שבחרתם; תיאום תפילה וסיור מודרך אינם בהכרח ביקור רגיל.'],
  ['איפה נמצא גן גת שמנים?', 'למרגלות הר הזיתים בירושלים, באזור נחל קדרון, לצד כנסיית כל העמים. השתמשו בקישור למפה להתמצאות ואשרו את הכניסה הפעילה; סיכת מפה אינה אישור לחניה או להורדת נוסעים.'],
  ['האם יש מסלול נגיש לכיסאות גלגלים?', 'אין בידינו בדיקת נגישות עדכנית של כניסות, מדרגות ושירותים. יש לברר את המסלול וההתאמות הנדרשות מול המפעיל מראש; אין כאן הבטחה למסלול שטוח, לספסלים או להגעה ברכב עד השער.'],
  ['איך מתאמים תפילה או ביקור קבוצה?', 'משרד הצליינים הפרנציסקאני (FPO) מרכז הזמנות למיסות, שעות קודש ותפילות במקומות שבאחריות הקוסטודיה. בדקו את תנאי התיאום ישירות מול המשרד; שעות המשרד אינן שעות הפתיחה של הגן או הכנסייה.'],
  ['איך מבקרים בכבוד?', 'שמרו על שקט ולבוש מכבד, אל תפריעו למתפללים ופעלו לפי השילוט והנחיות הצוות. בקשו רשות לפני צילום אנשים או טקסים. אין לקטוף, לטפס על העצים או לחצות מחסומים.'],
  ['האם אפשר לשלב אתרים נוספים?', 'המערה, קבר מרים ואתרים אחרים בהר הזיתים דורשים בדיקה נפרדת של הכניסה והפעילות. אין כאן מסלול הליכה מדוד או הבטחה שאפשר לשלבם בזמן קצר.']
];
const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${canonical}#garden`,
  name: 'Garden of Gethsemane',
  alternateName: ['גן גת שמנים', 'Garden of Olives'],
  description: 'גן הזיתים בגת שמנים, למרגלות הר הזיתים בירושלים; מקום קדוש במסורת הנוצרית.',
  url: canonical,
  address: { '@type': 'PostalAddress', addressLocality: 'Jerusalem' },
  geo: { '@type':'GeoCoordinates', latitude:31.7793098, longitude:35.2397801 },
  hasMap: mapsUrl
};
const relatedPlaces = {
  '@context': 'https://schema.org', '@graph': [
    { '@type':'Church', '@id':`${canonical}#church`, name:'Church of All Nations', alternateName:['כנסיית כל העמים','Basilica of the Agony'], address:{'@type':'PostalAddress',addressLocality:'Jerusalem'} },
    { '@type':'Place', '@id':`${canonical}#grotto`, name:'Grotto of Gethsemane', alternateName:'מערת גת שמנים', address:{'@type':'PostalAddress',addressLocality:'Jerusalem'} },
    { '@type':'WebPage', '@id':`${canonical}#webpage`, url:canonical, name:title, description, inLanguage:'he', about:{'@id':`${canonical}#garden`}, mentions:[{'@id':`${canonical}#church`},{'@id':`${canonical}#grotto`}] }
  ]
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(([q, a]) => ({ '@type': 'Question', 'name': q, 'acceptedAnswer': { '@type': 'Answer', 'text': a } }))
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'גת שמנים — מדריך ביקור',
  'url': site,
  'inLanguage': 'he'
};
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#193c35" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="he" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/favicon-32.svg" sizes="32x32" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:image" content={heroImage} />
  <meta property="og:image:alt" content="איור מקורי וסמלי של ענפי זית; אינו תצלום של גת שמנים" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={heroImage} /><meta name="twitter:image:alt" content="איור מקורי וסמלי של ענפי זית; אינו תצלום של גת שמנים" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline define:vars={{ ga: 'G-HXM22WWPKP' }}>
    window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', ga);
  </script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(relatedPlaces)} />
</head>
<body>
  <a class="skip-link" href="#main-content">דילוג לתוכן</a>
  <header class="site-header"><div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5"><a href="#top" class="flex min-w-0 items-center gap-3 font-bold"><img src="/icons/logo.svg" width="40" height="40" alt="" /><span>גת שמנים</span></a><details id="section-menu" class="section-menu"><summary>תפריט ביקור</summary><nav aria-label="תוכן העמוד">{[['story','על המקום'],['history','היסטוריה'],['visit','שעות ותנאי כניסה'],['weather','מזג אוויר'],['map','הגעה'],['services','נגישות ושירותים'],['around','מקומות נפרדים'],['faq','שאלות נפוצות'],['sources','מקורות'],['privacy','פרטיות']].map(([id,label])=><a href={'#'+id}>{label}</a>)}</nav></details></div></header>
  <main id="main-content"><div id="top"></div>
    <section class="relative isolate flex min-h-[720px] items-end overflow-hidden bg-olive"><img src="/images/olive-illustration.svg" alt="איור סמלי מקורי של ענפי זית, לא תצלום של גת שמנים" width="1200" height="800" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-center opacity-75" /><div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#112b26] via-[#193c35]/55 to-[#193c35]/15"></div><div class="mx-auto w-full max-w-7xl px-5 pb-20 pt-44"><div class="max-w-3xl reveal"><p class="mb-5 flex items-center gap-2 text-sm tracking-[.15em] text-gold"><span class="h-px w-10 bg-gold"></span> למרגלות הר הזיתים · ירושלים</p><h1 class="display text-6xl leading-[.95] text-white md:text-8xl">גן גת שמנים<br /><em class="not-italic text-gold">ירושלים</em></h1><p class="mt-8 max-w-xl text-lg leading-8 text-white/80">גן הזיתים, כנסיית כל העמים והמערה הם מקומות קשורים אך נפרדים. הכירו את המסורת ובדקו את שעות הגישה למקום המדויק לפני הביקור.</p><div class="mt-9 flex flex-wrap gap-3"><a href="#visit" class="inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 font-bold text-olive transition hover:-translate-y-0.5"><span>לתכנן ביקור</span><ArrowLeft size={18} /></a><a href="#story" class="rounded-full border border-white/30 px-6 py-3 text-white hover:bg-white/10">לגלות את המקום</a></div></div></div><div class="absolute bottom-6 left-5 right-5 text-sm text-white/80">איור סמלי מקורי של ענפי זית — אינו תצלום או מפת האתר. <a class="underline" href="#image-credits">פרטי האיור</a></div></section>

    <section id="story" class="texture"><div class="mx-auto max-w-7xl px-5 py-16 md:py-24"><p class="mb-4 text-sm font-bold text-olive2">על המקום</p><h2 class="display mb-6 text-4xl text-olive md:text-5xl">גן הזיתים ומקומות התפילה</h2><div class="max-w-3xl space-y-5 text-lg leading-9"><p>גן גת שמנים נמצא למרגלות הר הזיתים, סמוך לנחל קדרון. במסורת הנוצרית הוא קשור לתפילת ישו לפני מעצרו. זהו מקום של פולחן וזיכרון, ולא רק אתר לטיול.</p><p>הקוסטודיה הפרנציסקאנית מבחינה בין מטע הזיתים, <a href="#church" class="underline">בזיליקת היגון / כנסיית כל העמים</a> ו<a href="#grotto" class="underline">מערת גת שמנים</a>. שמותיה של הכנסייה אינם שמות חלופיים לגן.</p><p class="rounded-2xl bg-white p-5">Google Maps: <bdi>{ratingValue} / 5</bdi> · <bdi>{reviewCount}</bdi> ביקורות · נבדק ב־<bdi>{syncDate}</bdi>. הנתונים הם צילום מצב של צד שלישי, אינם ביקורות שנאספו באתר זה ועשויים להשתנות. <a class="underline" href={mapsUrl}>לרשומה העדכנית במפות</a>.</p></div></div></section>

    <section id="history" class="bg-[#efe9dd]"><div class="mx-auto max-w-7xl px-5 py-16 md:py-24"><p class="mb-4 text-sm font-bold text-olive2">היסטוריה ומסורת</p><h2 class="display mb-6 text-4xl text-olive md:text-5xl">מסורת נוצרית ושכבות היסטוריות</h2><div class="max-w-3xl space-y-5 text-lg leading-9"><p>הקוסטודיה מתארת את גת שמנים כמקום המנציח את תפילת ישו ואת מעצרו, לפי המסורת הנוצרית. המסורת על עצי הזית אינה מדידת גיל מדעית של כל עץ הקיים היום.</p><p>לפי תולדות האתר שמפרסמת הקוסטודיה, הכנסייה המודרנית נחנכה ב־<bdi>1924</bdi> ותוכננה בידי אנטוניו ברלוצי, על גבי שרידי כנסיות קודמות. <a href={operatorUrl} class="underline">לרקע ההיסטורי באתר המפעיל</a>.</p></div></div></section>

    <section id="weather" class="bg-sand"><div class="mx-auto max-w-7xl px-5 py-24"><div class="mb-10"><p class="mb-4 text-sm font-bold tracking-widest text-olive2">מזג אוויר בירושלים</p><h2 class="display text-5xl text-olive md:text-6xl">כדאי לדעת לפני שיוצאים</h2><p class="mt-4 max-w-xl leading-7 text-ink/65">נתוני מודל לירושלים מאת Open-Meteo, לא מדידה בגן ולא אישור שהאתר פתוח. נתונים חסרים או ישנים לא יוצגו כתחזית עדכנית.</p></div><div class="grid gap-4 md:grid-cols-[1.05fr_1.95fr]"><div id="weather-now" class="rounded-2xl bg-white p-7 shadow-sm text-ink/70">טוען נתוני מזג אוויר…</div><div id="weather-days" class="grid grid-cols-2 gap-3 rounded-2xl bg-white p-7 shadow-sm sm:grid-cols-3 lg:grid-cols-7"></div></div><div id="weather-advice" class="mt-4"></div><p id="weather-note" role="status" class="mt-4 text-sm text-ink/75"></p><p class="mt-4 text-sm leading-7">נתונים: <a class="underline" href="https://open-meteo.com/">Open-Meteo</a> · <a class="underline" href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. בדקו <a class="underline" href="https://ims.gov.il/">אזהרות של השירות המטאורולוגי</a>. <button id="weather-retry" type="button" class="ml-2 rounded border border-olive px-3 py-2">ניסיון נוסף</button></p><noscript><p>לטעינת תחזית נדרש JavaScript. בדקו את המקורות המקושרים לתחזית ולאזהרות.</p></noscript></div></section>

    <section id="image-credits" class="bg-olive"><div class="mx-auto max-w-7xl px-5 py-10 text-white"><h2 class="mb-3 text-xl font-bold">איור, לא תצלום</h2><p class="max-w-3xl leading-8">איור ענפי הזית בעמוד ובתמונת השיתוף נוצר עבור המדריך, ללא שימוש בתצלומי האתר או ביצירות אמנות מהכנסייה. זהו דימוי סמלי, לא תיעוד של הגן ולא תרשים ניווט. האיור זמין תחת <a class="underline" href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a>.</p></div></section>

    <section id="visit" class="bg-sand"><div class="mx-auto max-w-7xl px-5 py-16 md:py-24"><p class="mb-4 text-sm font-bold text-olive2">תכנון ביקור · נבדק ב־29.10.2026</p><h2 class="display mb-6 text-4xl text-olive md:text-5xl">שעות פתיחה: יש לבדוק איזה מקום</h2><p class="mb-6 max-w-3xl leading-8">יש הבדלים בין פרסומי המפעיל לבין מרכז המידע הנוצרי (CIC), שעמוד השעות שלו מעודכן ל־15.9.2026. המפה שסקרנו לא הציגה שעות. הנתונים להלן הם פרסומים לעיון, לא אישור שהאתרים פתוחים היום; חגים, תפילות ושינויים בגישה עלולים להשפיע.</p><p class="mb-3 text-sm">במסך צר אפשר לגלול את הטבלה לצדדים.</p><div class="hours-table" tabindex="0" role="region" aria-label="טבלת שעות פתיחה; אפשר לגלול לצדדים"><table><caption>פרסומי שעות נפרדים — יש לאשר ישירות לפני היציאה</caption><thead><tr><th scope="col">מקום ומקור</th><th scope="col">אפריל–ספטמבר</th><th scope="col">אוקטובר–מרץ</th><th scope="col">מה חשוב לבדוק</th></tr></thead><tbody><tr><th scope="row">המתחם — <a href={operatorUrl}>קוסטודיה</a></th><td><bdi>08:00–18:00</bdi></td><td><bdi>08:00–17:00</bdi></td><td>הפרסום מתייחס למתחם; לא נמצא בו לוח עצמאי לגן בלבד.</td></tr><tr id="church"><th scope="row">כנסיית כל העמים — <a href={cicUrl}>CIC</a></th><td><bdi>07:30–18:00</bdi></td><td><bdi>07:30–17:00</bdi></td><td>פתיחה חצי שעה לפני פרסום הקוסטודיה; כניסה אחרונה 10 דקות לפני הסגירה.</td></tr><tr id="grotto"><th scope="row">המערה — <a href={operatorUrl}>קוסטודיה</a></th><td><bdi>08:00–12:00</bdi><br/><bdi>14:30–17:00</bdi></td><td><bdi>08:00–12:00</bdi><br/><bdi>14:30–17:00</bdi></td><td>בימי חמישי וראשון מצוינת סגירה ב־<bdi>16:00</bdi>.</td></tr><tr><th scope="row">המערה — <a href={cicUrl}>CIC</a></th><td><bdi>07:30–12:00</bdi><br/><bdi>14:30–18:00</bdi></td><td><bdi>07:30–12:00</bdi><br/><bdi>14:30–17:00</bdi></td><td>כניסה אחרונה 10 דקות לפני סגירת הצהריים והערב. פרסום זה שונה גם בשעת הסגירה בקיץ; יש לאשר את החריגים.</td></tr></tbody></table></div><p class="mt-5 max-w-3xl leading-8">אל תסיקו משעות מיסה או תפילה מיוחדת ששעות התיירות הורחבו. מידע מהמתחם: <a href="tel:+97226266444" class="underline"><bdi>+972 2 626 6444</bdi></a>, כפי שמופיע במקורות; יש לוודא את ההסדר למקום המדויק.</p><div class="mt-8 grid gap-5 md:grid-cols-2"><article class="rounded-2xl bg-white p-7"><h3 class="mb-3 text-xl font-bold">מחיר ותנאי כניסה</h3><p class="leading-8">לא אותר מחירון עדכני שמאשר כניסה ללא תשלום לכל חלקי המתחם והשירותים. בררו עם המפעיל אם נדרש תשלום או תיאום לפעילות שבחרתם. האתר הזה אינו מוכר כרטיסים.</p></article><article class="rounded-2xl bg-white p-7"><h3 class="mb-3 text-xl font-bold">תפילות וקבוצות</h3><p class="leading-8"><a href="https://www.cicts.org/en/fpo" class="underline">משרד הצליינים הפרנציסקאני (FPO)</a> מרכז תיאום מיסות, שעות קודש ותפילות. בדקו את תנאי ההזמנה ישירות מולו; שעות עבודת המשרד אינן שעות האתר.</p></article></div></div></section>

    <section id="around" class="bg-[#e7dfd0]"><div class="mx-auto max-w-7xl px-5 py-16 md:py-24"><p class="mb-4 text-sm font-bold text-olive2">מקומות קשורים, תנאי ביקור נפרדים</p><h2 class="display mb-6 text-4xl text-olive md:text-5xl">הגן, הכנסייה והמערה</h2><div class="grid gap-5 md:grid-cols-3"><article class="rounded-2xl bg-white p-7"><h3 class="mb-3 text-xl font-bold">גן הזיתים</h3><p class="leading-8">המקום המזוהה במסורת עם תפילת ישו. בדקו את הכניסה הפעילה ואת הגישה לשבילי הביקור; סיור בגן אינו אישור להיכנס לכל שטח סמוך.</p></article><article class="rounded-2xl bg-white p-7"><h3 class="mb-3 text-xl font-bold">כנסיית כל העמים</h3><p class="leading-8">נקראת גם בזיליקת היגון. הכניסה לבניין כפופה לפעילות הדתית ולהנחיות הצוות; אין להחליף בין שמה לבין שם הגן.</p></article><article class="rounded-2xl bg-white p-7"><h3 class="mb-3 text-xl font-bold">מערת גת שמנים</h3><p class="leading-8">מקום נפרד לצד קבר מרים, לפי תיאור הקוסטודיה. יש לה הפסקת צהריים ופרסומי שעות משלה; ראו את ההבדלים בטבלת השעות.</p></article></div><div id="map" class="mt-8 rounded-2xl bg-olive p-7 text-white"><h3 class="mb-3 text-xl font-bold">הגעה והתמצאות</h3><p class="max-w-3xl leading-8">גת שמנים נמצאת למרגלות הר הזיתים בירושלים. <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="underline text-gold">פתחו את רשומת Google Maps</a> להתמצאות, ובדקו בנפרד את הכניסה הפעילה, התחבורה בחזרה וכללי הורדת הנוסעים. אין כאן אישור לחניה, מסלול אוטובוס או זמן הליכה מדוד.</p><p class="mt-3 text-sm">המפה נפתחת באתר חיצוני של Google רק בלחיצה על הקישור.</p></div></div></section>

    <section id="services" class="bg-sand"><div class="mx-auto max-w-7xl px-5 py-16 md:py-24"><p class="mb-4 text-sm font-bold text-olive2">נגישות ושירותים</p><h2 class="display mb-6 text-4xl text-olive md:text-5xl">מה לברר מראש</h2><div class="grid gap-5 md:grid-cols-3"><article class="rounded-2xl bg-white p-7"><h3 class="mb-3 text-xl font-bold">כניסה ודרך נגישה</h3><p class="leading-8">אין בידינו סקר עדכני של מדרגות, שיפועים או מסלול לכיסא גלגלים. בקשו מידע על הכניסה הנכונה ועל הדרך לחלק הספציפי שבו תרצו לבקר.</p></article><article class="rounded-2xl bg-white p-7"><h3 class="mb-3 text-xl font-bold">מים, שירותים ומנוחה</h3><p class="leading-8">לא אומתו זמינות מי שתייה, שירותים או ספסלים. שאלו על ההתאמות הדרושות לכם והיערכו למנוחה ולמים, בלי להסתמך על הבטחה למתקנים באתר.</p></article><article class="rounded-2xl bg-white p-7"><h3 class="mb-3 text-xl font-bold">חניה ותחבורה</h3><p class="leading-8">בדקו הסדרי חניה, מקום הורדה ואיסוף ודרך חזרה עם ספק התחבורה. אין במדריך המלצה לחניון מסוים או אישור שחניה ברחוב מותרת.</p></article></div></div></section>

    <section id="routes" class="bg-[#efe9dd]"><div class="mx-auto max-w-7xl px-5 py-16 md:py-24"><h2 class="display mb-6 text-4xl text-olive">תכנון בלי לוח זמנים קשיח</h2><ol class="max-w-3xl list-decimal space-y-4 pr-5 text-lg leading-9"><li>בחרו אם ברצונכם לבקר בגן, בכנסייה או במערה — ובדקו כל מקום בנפרד.</li><li>אשרו שעות, תפילות, הפסקות וכניסה אחרונה לפני היציאה.</li><li>התאימו את משך הביקור ואת המסלול לצורכי הקבוצה ולתנאי הגישה באותו יום.</li><li>אם מוסיפים אתרים בהר הזיתים או בעיר העתיקה, בדקו עבורם שעות ותחבורה בנפרד. אין הבטחה למסלול קצר או לחזרה סמוך לשקיעה.</li></ol></div></section>

