      if (tmax >= 32) { outfit.push('חם יחסית — לבשו בגדים קלים ונושמים.'); plan.push('קצרו שהות בחוץ בשעות הצהריים; עדיף לבקר מוקדם או לקראת ערב.'); items.push('קרם הגנה, משקפי שמש, מים'); }
