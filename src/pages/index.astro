      80: ['🌦️', 'ממטרים'], 81: ['🌧️', 'ממטרים'], 82: ['⛈️', 'ממטרים חזקים'], 85: ['🌨️', 'ממטרי שלג'], 86: ['🌨️', 'ממטרי שלג'],
