      if ((tmax - tmin) > 8) { outfit.push('הפרש טמפרטורות גדול בין יום ללילה — כדאי שכבת לבוש נוספת.'); }
      if (gust >= 50) { warn.push('רוחות חזקות — הימנעו מאזורים חשופים ומעצמים; פעילויות בגובה עשויות להיפסק.'); items.push('כובע שעלול לעוף; עדיף לא בגדים רחבים'); }
      else if (wind >= 29) { outfit.push('רוחות מתונות — כובע עשוי לעוף.'); }
      if (isClear) { plan.push('מזג אוויר נאה — מתאים לביקור בחוץ ולתצפיות שקיעה.'); }
      if (isCloud) { plan.push('אור רך — מצוין לצילום ולשיטוט ממושך בחוץ.'); }
      if (isFog) { warn.push('ערפל — הראות לקויה; זהירות בהליכה ובנהיגה.'); }
      if (!outfit.length) outfit.push('אין המלצת לבוש מיוחדת — לבוש רגיל מתאים.');
      if (!plan.length) plan.push('מזג האוויר מאפשר ביקור רגיל באתר.');
      const itemsUniq = [...new Set(items)];
      if (!itemsUniq.length) itemsUniq.push('אין ציוד מיוחד נדרש.');
      return { warn, outfit, plan, items: itemsUniq };
    }

    function renderAdvice(a) {
      const box = document.getElementById('weather-advice');
      let html = '';
      if (a.warn.length) {
        html += '<div class="rounded-2xl border border-red-300 bg-red-50 p-5 text-red-800"><p class="mb-2 font-bold">⚠️ התראה</p><ul class="list-disc pr-5 space-y-1 text-sm">' + a.warn.map((w) => '<li>' + w + '</li>').join('') + '</ul></div>';
      }
      const cols = [['לבוש וציוד', a.outfit], ['תכנון הביקור', a.plan], ['מה לקחת איתך', a.items]];
      html += '<div class="mt-4 grid gap-4 md:grid-cols-3">' + cols.map(([t, arr]) =>
        '<div class="rounded-2xl bg-white p-6 shadow-sm"><h3 class="mb-3 text-lg font-bold text-olive">' + t + '</h3><ul class="space-y-2 text-sm leading-7 text-ink/75">' +
        arr.map((x) => '<li class="flex gap-2"><span class="text-gold">✓</span><span>' + x + '</span></li>').join('') + '</ul></div>'
      ).join('') + '</div>';
      box.innerHTML = html;
    }

    async function loadWeather() {
      const now = document.getElementById('weather-now');
      const days = document.getElementById('weather-days');
      const note = document.getElementById('weather-note');
      try {
        const res = await fetch('/api/weather');
        if (!res.ok) throw new Error('bad');
        const d = await res.json();
        const cur = d.current;
        const ci = codeInfo(cur.weather_code);
        const prob = (d.daily.precipitation_probability_max && d.daily.precipitation_probability_max[0]) || 0;
        const uv = (d.daily.uv_index_max && d.daily.uv_index_max[0]) || cur.uv_index || 0;
        now.innerHTML =
          '<div class="flex items-center gap-4"><div class="text-6xl">' + ci[0] + '</div>' +
          '<div><p class="text-3xl font-bold text-olive">' + Math.round(cur.temperature_2m) + '°C</p>' +
          '<p class="text-sm text-ink/70">' + ci[1] + '</p></div></div>' +
          '<div class="mt-5 grid grid-cols-2 gap-3 text-sm text-ink/70">' +
          '<div>מרגיש כמו ' + Math.round(cur.apparent_temperature) + '°C</div>' +
          '<div>לחות ' + cur.relative_humidity_2m + '%</div>' +
          '<div>רוח ' + Math.round(cur.wind_speed_10m) + ' קמ"ש</div>' +
          '<div>UV ' + Math.round(uv) + '</div>' +
          '<div class="col-span-2">סיכוי גשם היום: ' + prob + '%</div></div>';
        days.innerHTML = '';
        d.daily.time.forEach((t, i) => {
          const dt = new Date(t + 'T00:00:00');
          const di = codeInfo(d.daily.weather_code[i]);
          const cell = document.createElement('div');
          cell.className = 'rounded-xl bg-sand px-3 py-4 text-center';
          cell.innerHTML =
            '<p class="text-xs font-semibold text-olive2">' + (i === 0 ? 'היום' : WD[dt.getDay()]) + '</p>' +
            '<div class="my-2 text-3xl">' + di[0] + '</div>' +
            '<p class="text-sm font-bold text-olive">' + Math.round(d.daily.temperature_2m_max[i]) + '°</p>' +
            '<p class="text-xs text-ink/55">' + Math.round(d.daily.temperature_2m_min[i]) + '°</p>' +
            '<p class="mt-1 text-[11px] text-ink/45">גשם ' + d.daily.precipitation_probability_max[i] + '%</p>';
          days.appendChild(cell);
        });
        renderAdvice(buildAdvice(d));
        note.textContent = 'נתוני מזג אוויר לירושלים וסביבות גת שמנים, מתעדכנים במהלך היום.';
      } catch (e) {
        now.textContent = 'לא ניתן לטעון את נתוני מזג אוויר כעת. נסו שוב מאוחר יותר.';
        if (note) note.textContent = '';
      }
    }
    loadWeather();
  </script>
  <script is:inline>if ('serviceWorker' in navigator) { window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); }); }</script>
</body></html>
