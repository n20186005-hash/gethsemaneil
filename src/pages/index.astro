    };
    const WD = ['ראשון', 'שני', 'שלישי', 'רביעי', 'חמישי', 'שישי', 'שבת'];
    const codeInfo = (c) => WX[c] || ['🌡️', 'מזג אוויר'];

    function buildAdvice(d) {
      const cur = d.current;
      const day = d.daily;
      const code = cur.weather_code;
      const tmax = day.temperature_2m_max[0];
      const tmin = day.temperature_2m_min[0];
      const prob = (day.precipitation_probability_max && day.precipitation_probability_max[0]) || 0;
      const uv = (day.uv_index_max && day.uv_index_max[0]) || cur.uv_index || 0;
      const wind = cur.wind_speed_10m;
      const gust = cur.wind_gusts_10m || wind;
      const isRain = [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code);
      const isHeavy = [65, 66, 67, 82].includes(code);
      const isStorm = code >= 95;
      const isFog = code === 45 || code === 48;
      const isClear = code <= 1;
      const isCloud = code === 3;
      const warn = [], outfit = [], plan = [], items = [];
      if (prob >= 60) { plan.push('סיכוי גבוה לגשם — עדיף לתכנן ביקור באתרים מקורים ולדחות מסלולים רגליים פתוחים.'); items.push('מטריה או מעיל גשם'); }
