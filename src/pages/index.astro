  </main>
  <footer class="bg-olive text-white"><div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-12 md:flex-row md:items-end md:justify-between"><div><div class="mb-3 flex items-center gap-3"><img src="/icons/logo.svg" class="h-9 w-9" alt="" /><span class="font-bold">גת שמנים</span></div><p class="max-w-sm text-sm leading-6 text-white/55">מדריך עצמאי למבקרים. מידע על שעות, גישה ואירועים עשוי להשתנות.</p></div><div class="text-sm text-white/45 md:text-left">לאתר זה אין קשר רשמי עם גת שמנים, כנסיית כל העמים או הגופים המנהלים את האתר.<br />© מדריך ירושלים עצמאי</div></div></footer>

  <script is:inline>
    const WX = {
