{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gethsemane-guide",
  "main": "./worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
