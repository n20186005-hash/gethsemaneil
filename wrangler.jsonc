{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gethsemaneil",
  "main": "./worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
